# metadata-api environment variables
# Copy to .env and fill in the values.

# Server
PORT=3001

# IPFS / Pinata
# Get your keys at: https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_secret_api_key

# IPFS gateway used in metadata image URLs (default: https://ipfs.io/ipfs)
IPFS_GATEWAY=https://ipfs.io/ipfs

# Frontend URL for puppeteer rendering (must be running when pinning)
RENDER_BASE_URL=http://localhost:5173

# Directory to store ipfs-cache.json (default: cwd / packages/metadata-api)
# DATA_DIR=/data
