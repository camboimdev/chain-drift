# Chain the game runs on. 84532 = Base Sepolia (default), 8453 = Base mainnet.
VITE_CHAIN_ID=84532

# Optional dedicated RPC (Alchemy, QuickNode…). Falls back to the public endpoint,
# which is rate limited and will struggle once several races poll at once.
# VITE_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<key>

# Deployed contracts — copy from packages/contracts/deployments/<chainId>.json
VITE_DRIFT_TOKEN_ADDRESS=
VITE_CAR_NFT_ADDRESS=
VITE_RACE_ESCROW_ADDRESS=
VITE_LEADERBOARD_ADDRESS=

# IPFS gateways used to fetch car GLB/PNG assets, comma-separated, in
# preference order. Each is tried in turn until one responds, so a gateway
# outage degrades gracefully instead of breaking the garage.
# Defaults to gateway.pinata.cloud -> dweb.link -> w3s.link -> ipfs.io.
# VITE_IPFS_GATEWAYS=https://<your-gw>.mypinata.cloud/ipfs,https://dweb.link/ipfs
