# ─── Deployer ─────────────────────────────────────────────────────────────
# Never use a key that holds mainnet funds.
PRIVATE_KEY=

# ─── RPC ──────────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Contract verification on Basescan
BASESCAN_API_KEY=

# ─── Chainlink VRF v2.5 ───────────────────────────────────────────────────
# Create and fund a subscription at https://vrf.chain.link, then add the
# deployed RaceEscrow as a consumer.
#
# Base Sepolia (chainId 84532)
VRF_COORDINATOR=0x5C210eF41CD1a72de73bF76eC39637bB0d3d7BEE
VRF_KEY_HASH=0x9e1344a1247c8a1785d0a4681a27152bffdb43666ae5bf7d14d24a5efd44bf71
VRF_SUBSCRIPTION_ID=
#
# Base mainnet (chainId 8453)
# VRF_COORDINATOR=0xd5D517aBE5cF79B7e95eC98dB0f0277788aFF634
# VRF_KEY_HASH=0xdc2f87677b01473c763cb0aee938ed3341512f6057324a584e5944e786144d70

# ─── Game parameters (optional) ───────────────────────────────────────────
MINT_FEE_DRIFT=1
INITIAL_SUPPLY_DRIFT=10000000
TOKEN_BASE_URI=http://localhost:3001/metadata/
FAUCET_ENABLED=true
# Address that will run the leaderboard recorder; defaults to the deployer.
# RECORDER_ADDRESS=
