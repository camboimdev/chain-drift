# ─── Deployer ─────────────────────────────────────────────────────────────
# Seed phrase for the deployer. A mnemonic derives every account under it and
# the same seed produces the same addresses on mainnet, so use one created for
# this project alone and never fund it from a wallet you care about.
MNEMONIC=

# Account index on m/44'/60'/0'/0/{index} — 0 is the first account MetaMask and
# Coinbase Wallet show for a seed phrase.
MNEMONIC_INDEX=0

# Check which address this derives, and its balance, without echoing the phrase:
#   forge script script/ShowDeployer.s.sol --rpc-url base_sepolia

# ─── Faucet top-up (optional) ─────────────────────────────────────────────
# Only needed by `pnpm faucet`, which tops the deployer up programmatically.
# Create a key at https://portal.cdp.coinbase.com.
#
# Both the portal and the API pay 0.0001 ETH per claim, capped at 1000 claims
# per 24h, so a meaningful balance is only reachable through the script.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# ─── RPC ──────────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Contract verification on Basescan
BASESCAN_API_KEY=

# ─── Chainlink VRF v2.5 ───────────────────────────────────────────────────
# The deploy script creates and funds the subscription itself, in native ETH.
# VRF v2.5 bills a native-funded subscription in the chain's own token, so the
# same ETH that pays for gas pays for the randomness — no LINK faucet needed.
#
# Base Sepolia (chainId 84532)
VRF_COORDINATOR=0x5C210eF41CD1a72de73bF76eC39637bB0d3d7BEE
VRF_KEY_HASH=0x9e1344a1247c8a1785d0a4681a27152bffdb43666ae5bf7d14d24a5efd44bf71
#
# Base mainnet (chainId 8453)
# VRF_COORDINATOR=0xd5D517aBE5cF79B7e95eC98dB0f0277788aFF634
# VRF_KEY_HASH=0xdc2f87677b01473c763cb0aee938ed3341512f6057324a584e5944e786144d70

# Native ETH deposited into the new subscription. Each race resolution burns a
# little of this; top it up later with `fundSubscriptionWithNative`.
#
# The floor is set by affordability, not by what a race actually costs. Before
# fulfilling, the DON reserves `callbackGasLimit` x the gas lane's max price and
# refuses the request if the subscription cannot cover it — on the 30 gwei lane
# that is 300_000 x 30 gwei = 0.009 ETH, plus a premium. A subscription funded
# with exactly 0.01 leaves the request pending indefinitely and the race stuck
# in Resolving until the refund timeout. 0.02 clears the reserve with room for
# many races on top of it.
VRF_FUND_WEI=20000000000000000

# Set this to reuse an existing subscription instead of creating one. When set,
# VRF_FUND_WEI is ignored — fund that subscription yourself.
# VRF_SUBSCRIPTION_ID=

# ─── Game parameters (optional) ───────────────────────────────────────────
# Prices are set so a full four-car grid stakes exactly 100 DRIFT and every
# prize is a whole number of tokens: 1st 50, 2nd 25, 3rd 10, 4th 5, house 10.
# The race entry fee lives in the frontend (RACE_ENTRY_FEE in @chain-drift/shared)
# because each race room carries its own fee on-chain.
MINT_FEE_DRIFT=100
INITIAL_SUPPLY_DRIFT=10000000
TOKEN_BASE_URI=http://localhost:3001/metadata/
FAUCET_ENABLED=true
# Address that will run the leaderboard recorder; defaults to the deployer.
# RECORDER_ADDRESS=
