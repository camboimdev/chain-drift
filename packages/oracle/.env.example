# Chain the recorder watches. 84532 = Base Sepolia, 8453 = Base mainnet.
CHAIN_ID=84532

# Optional dedicated RPC. Falls back to the chain's public endpoint.
# RPC_URL=https://base-sepolia.g.alchemy.com/v2/<key>

# From packages/contracts/deployments/<chainId>.json
RACE_ESCROW_ADDRESS=
LEADERBOARD_ADDRESS=

# Same seed phrase the contracts were deployed with. Index 0 is the deployer,
# which is the address Leaderboard.setRecorder defaults to.
MNEMONIC=
MNEMONIC_INDEX=0

# Set to the RaceEscrow deployment block to backfill an empty leaderboard.
# START_BLOCK=

POLL_INTERVAL_MS=4000
