# Pinata credentials for the collection publishing scripts.
# Copy to scripts/collection/.env and fill in the values.
#
# Only pin-collection.mjs and pin-metadata-dir.mjs read this. Nothing the game
# runs at play time needs it — the collection is already pinned.

# Get your keys at: https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_secret_api_key
